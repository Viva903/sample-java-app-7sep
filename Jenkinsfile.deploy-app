// Build, publish, and deploy sonarqube-java-demo onto the deploy-vm "app" EC2 instance.
// Jenkins job Script Path: sample-java-app/Jenkinsfile.deploy-app
//
// Publishes the JAR to the CI artefacts S3 bucket, then uses SSM Send-Command so the
// app EC2 (pinned via APP_INSTANCE_ID, otherwise discovered by tag Role=app) pulls the
// artefact and (re)starts a systemd service. Finishes with an external HTTP check on
// port 80 to confirm the app is actually up and reachable.

pipeline {
    agent any

    parameters {
        string(
            name: 'AWS_REGION',
            defaultValue: 'us-east-1',
            description: 'AWS region for S3 and SSM (override; defaults to us-east-1)'
        )
    }

    environment {
        JAR_NAME = 'sonarqube-java-demo-0.0.1-SNAPSHOT.jar'
        S3_BUCKET = 'jj-vm-development-ci-artifacts-569202655273'
        APP_INSTANCE_ID = 'i-0d3daf832e40fac5f'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Build') {
            steps {
                sh 'echo "JAVA_HOME=$JAVA_HOME"; java -version; mvn -version'
                sh 'mvn -B -ntp clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn -B -ntp test'
            }
            post {
                always {
                    junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: true
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn -B -ntp package -DskipTests'
                sh "test -f target/${JAR_NAME}"
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }

        stage('Publish to S3') {
            steps {
                script {
                    if (!env.S3_BUCKET?.trim()) {
                        error('S3_BUCKET must be set as a Jenkins environment variable (terraform -chdir=deploy-vm output -raw ci_artifacts_bucket)')
                    }
                    env.S3_PREFIX = "sample-java-app/${env.BUILD_NUMBER}"
                }
                withEnv(["AWS_DEFAULT_REGION=${params.AWS_REGION}"]) {
                    sh '''
                        command -v aws >/dev/null || { echo "aws CLI not found on PATH"; exit 1; }
                        aws sts get-caller-identity
                        aws s3 cp "target/${JAR_NAME}" \
                          "s3://${S3_BUCKET}/${S3_PREFIX}/" \
                          --only-show-errors
                        aws s3 ls "s3://${S3_BUCKET}/${S3_PREFIX}/"
                    '''
                }
            }
        }

        stage('Deploy to Application VM') {
            steps {
                withEnv(["AWS_DEFAULT_REGION=${params.AWS_REGION}"]) {
                    script {
                        env.RESOLVED_INSTANCE_ID = sh(
                            script: '''
                                set -euo pipefail
                                INSTANCE_ID="${APP_INSTANCE_ID:-}"
                                if [ -z "${INSTANCE_ID}" ]; then
                                  INSTANCE_ID="$(aws ec2 describe-instances \
                                    --filters "Name=tag:Role,Values=app" "Name=instance-state-name,Values=running" \
                                    --query 'Reservations[0].Instances[0].InstanceId' \
                                    --output text)"
                                fi
                                if [ -z "${INSTANCE_ID}" ] || [ "${INSTANCE_ID}" = "None" ]; then
                                  echo "No running EC2 instance with tag Role=app found. Set APP_INSTANCE_ID or check deploy-vm." >&2
                                  exit 1
                                fi
                                echo "${INSTANCE_ID}"
                            ''',
                            returnStdout: true
                        ).trim()
                        echo "Deploying to instance ${env.RESOLVED_INSTANCE_ID}"
                    }
                    sh '''
                        set -euo pipefail

                        aws s3 cp ci/deploy-app.sh \
                          "s3://${S3_BUCKET}/${S3_PREFIX}/deploy-app.sh" \
                          --only-show-errors

                        INSTANCE_ID="${RESOLVED_INSTANCE_ID}"

                        cat > /tmp/ssm-deploy-params.json <<EOF
{
  "commands": [
    "export S3_BUCKET=${S3_BUCKET}",
    "export S3_PREFIX=${S3_PREFIX}",
    "export JAR_NAME=${JAR_NAME}",
    "export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}",
    "aws s3 cp s3://${S3_BUCKET}/${S3_PREFIX}/deploy-app.sh /tmp/deploy-app.sh --only-show-errors",
    "chmod +x /tmp/deploy-app.sh",
    "/tmp/deploy-app.sh"
  ]
}
EOF

                        COMMAND_ID="$(aws ssm send-command \
                          --instance-ids "${INSTANCE_ID}" \
                          --document-name "AWS-RunShellScript" \
                          --comment "sample-java-app deploy build ${BUILD_NUMBER}" \
                          --timeout-seconds 600 \
                          --parameters file:///tmp/ssm-deploy-params.json \
                          --query 'Command.CommandId' \
                          --output text)"

                        echo "SSM CommandId=${COMMAND_ID}"
                        aws ssm wait command-executed \
                          --command-id "${COMMAND_ID}" \
                          --instance-id "${INSTANCE_ID}" || true

                        STATUS="$(aws ssm get-command-invocation \
                          --command-id "${COMMAND_ID}" \
                          --instance-id "${INSTANCE_ID}" \
                          --query 'Status' \
                          --output text)"
                        aws ssm get-command-invocation \
                          --command-id "${COMMAND_ID}" \
                          --instance-id "${INSTANCE_ID}" \
                          --query '{Status:Status,Stdout:StandardOutputContent,Stderr:StandardErrorContent}' \
                          --output json

                        if [ "${STATUS}" != "Success" ]; then
                          echo "SSM command status was ${STATUS}, expected Success"
                          exit 1
                        fi
                        echo "Deploy succeeded on ${INSTANCE_ID}"
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withEnv(["AWS_DEFAULT_REGION=${params.AWS_REGION}"]) {
                    sh '''
                        set -euo pipefail

                        PUBLIC_IP="$(aws ec2 describe-instances \
                          --instance-ids "${RESOLVED_INSTANCE_ID}" \
                          --query 'Reservations[0].Instances[0].PublicIpAddress' \
                          --output text)"
                        if [ -z "${PUBLIC_IP}" ] || [ "${PUBLIC_IP}" = "None" ]; then
                          echo "Instance ${RESOLVED_INSTANCE_ID} has no public IP; cannot verify externally."
                          exit 1
                        fi

                        HEALTH_URL="http://${PUBLIC_IP}/users/echo?q=ok"
                        echo "Checking ${HEALTH_URL}"
                        for i in $(seq 1 12); do
                          if curl -fsS -m 5 "${HEALTH_URL}"; then
                            echo ""
                            echo "App is up and responding on port 80 at ${PUBLIC_IP}"
                            exit 0
                          fi
                          echo "Not up yet (attempt ${i}/12), retrying in 5s..."
                          sleep 5
                        done

                        echo "App did not respond on port 80 at ${PUBLIC_IP} after deployment"
                        exit 1
                    '''
                }
            }
        }
    }
}
